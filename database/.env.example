# ==============================================================================
# Dependency Hub - Database Environment Configuration Template
# ==============================================================================

POSTGRES_DB=dependencyhub
POSTGRES_USER=dependencyhub
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async Database URL for SQLAlchemy 2.x / asyncpg
DATABASE_URL=postgresql+asyncpg://dependencyhub:change_me@localhost:5432/dependencyhub

# Optional DB Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
