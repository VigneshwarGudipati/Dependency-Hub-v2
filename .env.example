# =============================================================================
# Dependency Hub — Root Environment Template
# =============================================================================
#
# This file is a DOCUMENTATION TEMPLATE only. It is safe to commit.
# Do NOT commit your actual .env files.
#
# SETUP INSTRUCTIONS:
#   Backend (database tier):  copy database/.env.example → database/.env
#   Frontend:                 copy frontend/.env.example  → frontend/.env
#                             (or create frontend/.env manually)
#
# Each sub-project manages its own environment independently.
# See the sub-project .env.example files for authoritative variable lists.
#
# =============================================================================

# --- FRONTEND (frontend/.env) -------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- DATABASE / BACKEND (database/.env) ---------------------------------------
# POSTGRES_DB=dependencyhub
# POSTGRES_USER=dependencyhub
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://dependencyhub:CHANGE_ME@localhost:5432/dependencyhub

# --- BACKEND SECURITY ---------------------------------------------------------
# JWT_SECRET=CHANGE_ME_USE_32_BYTES_MIN
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- BACKEND ENCRYPTION -------------------------------------------------------
# ENCRYPTION_MASTER_KEY=CHANGE_ME_64_HEX_CHARS

# --- OPTIONAL BACKEND POOL SETTINGS -------------------------------------------
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_ECHO=false
