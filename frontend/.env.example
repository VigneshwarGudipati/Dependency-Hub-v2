# =============================================================================
# Dependency Hub — Frontend Environment Template
# =============================================================================
# Copy this file to .env and set actual values.
#   cp frontend/.env.example frontend/.env
#
# VITE_ prefix is required for variables to be available in the browser build.
# =============================================================================

# Base URL of the FastAPI backend (must not end with a slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1
