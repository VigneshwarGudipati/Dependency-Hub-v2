# =============================================================================
# Dependency Hub — Root .gitignore
# Covers both frontend/ (Node/Vite) and database/ (Python/FastAPI) subtrees.
# =============================================================================

# --- Python -------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
.mypy_cache/
.ruff_cache/

# --- Test / Coverage ----------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Node / Vite / TanStack ---------------------------------------------------
node_modules/
dist/
dist-ssr/
.output/
.vite/
.tanstack/
.wrangler/
.vinxi/
.nitro/

# --- Logs ---------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Secrets & Environment Files (NEVER COMMIT) --------------------------------
.env
.env.local
.env.*.local
.dev.vars
*.pem
*.key
*.secret
*.p12
*.pfx

# Keep .env.example files — they are templates, not secrets
!.env.example
!**/.env.example

# --- IDE & Editors ------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.c9/

# --- OS -----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Storage (local dev) ------------------------------------------------------
database/storage/

# --- Python build artifacts that may appear at root ---------------------------
*.pyc
.coverage.*
